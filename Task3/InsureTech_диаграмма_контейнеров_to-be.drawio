        <mxCell id="10" value="Клиент&lt;br&gt;[Person]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#06315C;fontColor=#ffffff;fontSize=14;fontStyle=1;fontFamily=Helvetica;arcSize=20;" vertex="1" parent="1">
