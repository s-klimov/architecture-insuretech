        <mxCell id="11" value="InsureTech Prod" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontSize=14;fontStyle=1;fontFamily=Helvetica;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=8;" vertex="1" parent="1">
          <mxGeometry x="190" y="90" width="1320" height="970" as="geometry" />
        </mxCell>

        <mxCell id="30" value="Платёжный сервис&lt;br&gt;[Software System]&lt;br&gt;Оплата страховки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="16" y="150" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Системы партнёров&lt;br&gt;[Software System]&lt;br&gt;Оформление страховок через API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="16" y="400" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="32" value="Системы страховых компаний&lt;br&gt;[Software System]&lt;br&gt;Продукты, тарифы, взаиморасчёты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#666666;fontColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1530" y="360" width="170" height="120" as="geometry" />
        </mxCell>

        <mxCell id="12" value="&lt;b&gt;InsureTech Web&lt;/b&gt;&lt;br&gt;[Container: JavaScript, React]&lt;br&gt;Веб-приложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="140" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;client-info&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Учёт клиентских данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="140" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;client-info-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;Данные клиентов" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="130" width="200" height="110" as="geometry" />
        </mxCell>

        <mxCell id="15" value="&lt;b&gt;core-app&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Заявки и локальная реплика продуктов&lt;br&gt;Transactional Outbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;[Container: Apache Kafka]&lt;br&gt;Потоки: продукты и тарифы,&lt;br&gt;оформленные полисы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="680" y="340" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;ins-product-aggregator&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Сам опрашивает страховые&lt;br&gt;и публикует изменения каталога" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="330" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="18" value="&lt;b&gt;core-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;Заявки, реплика тарифов,&lt;br&gt;таблица outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="260" y="560" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;ins-comp-settlement&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Подписчик каталога и полисов,&lt;br&gt;реестр для страховых" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="560" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;ins-comp-settlement-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;Полисы и условия расчёта" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1040" y="560" width="250" height="130" as="geometry" />
        </mxCell>

        <mxCell id="21" value="&lt;b&gt;Что изменилось&lt;/b&gt;&lt;br&gt;Каталог продуктов и оформленные полисы передаются через Kafka. core-app и ins-comp-settlement больше не опрашивают агрегатор и друг друга по расписанию. Состав сервисов тот же.&lt;br&gt;Transactional Outbox используется в core-app: полис и событие записываются в core-db одной транзакцией, publisher отправляет событие в Kafka. Для каталога продуктов outbox не используется: агрегатор повторяет опрос API страховых и публикует следующее обновление." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="760" width="1060" height="150" as="geometry" />
        </mxCell>

        <mxCell id="101" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="12">
