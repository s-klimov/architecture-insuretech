        <mxCell id="12" value="&lt;b&gt;InsureTech Web&lt;/b&gt;&lt;br&gt;[Container: JavaScript, React]&lt;br&gt;Веб-приложение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="130" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;client-info&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Учёт клиентских данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="130" width="270" height="100" as="geometry" />
        </mxCell>
        <mxCell id="14" value="&lt;b&gt;client-info-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;Данные клиентов" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="190" height="110" as="geometry" />
        </mxCell>

        <mxCell id="15" value="&lt;b&gt;core-app&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Заявки и оформление ОСАГО&lt;br&gt;Transactional Outbox&lt;br&gt;POST /osago/applications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="220" y="340" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;[Container: Apache Kafka]&lt;br&gt;Каталог, полисы,&lt;br&gt;заявки и предложения ОСАГО" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="320" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;ins-product-aggregator&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Сам опрашивает каталог&lt;br&gt;и публикует изменения" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1080" y="270" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="40" value="&lt;b&gt;osago-aggregator&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Создаёт заявку в страховых&lt;br&gt;и опрашивает решение.&lt;br&gt;API: события Kafka" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1040" y="510" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="41" value="&lt;b&gt;osago-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;Статус опроса по компаниям&lt;br&gt;и общий счётчик лимита" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1360" y="510" width="190" height="130" as="geometry" />
        </mxCell>

        <mxCell id="18" value="&lt;b&gt;core-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;Заявки, реплика тарифов,&lt;br&gt;предложения ОСАГО, outbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="560" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;ins-comp-settlement&lt;/b&gt;&lt;br&gt;[Container: Kotlin, Spring Boot]&lt;br&gt;Подписчик каталога и полисов,&lt;br&gt;реестр для страховых" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="770" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;ins-comp-settlement-db&lt;/b&gt;&lt;br&gt;[Container: PostgreSQL]&lt;br&gt;Полисы и условия расчёта" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0D5091;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="680" y="760" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="21" value="&lt;b&gt;ОСАГО&lt;/b&gt;&lt;br&gt;osago-aggregator сам создаёт заявку в страховых и опрашивает решение — так же, как ins-product-aggregator опрашивает каталог. Своя БД нужна: опрос длится до 60 секунд, сервис запущен в нескольких экземплярах, статус нельзя держать в памяти пода.&lt;br&gt;API для core-app — события Kafka. core-app через outbox публикует заявку. Агрегатор публикует предложение каждой компании сразу, как пришёл ответ. Общего синхронного ответа, который ждёт все компании, нет.&lt;br&gt;Веб создаёт заявку в core-app по REST: POST /osago/applications. Предложения получает по WebSocket и показывает их по одному. Ожидание заканчивается через 60 секунд.&lt;br&gt;На вызове страховой стоят паттерны: Timeout — 60 секунд на компанию, Retry — повтор опроса предложения, Circuit Breaker — не звать компанию, которая не отвечает, Rate Limiting — 2,5 тысячи заявок не уходят в одну компанию разом. Счётчик лимита лежит в osago-db и общий для всех экземпляров.&lt;br&gt;Несколько экземпляров учтены. Kafka отдаёт заявку одному экземпляру агрегатора (ключ — id заявки). Предложение пишется в core-db. WebSocket может быть на другом поде core-app, поэтому после записи все экземпляры получают NOTIFY из PostgreSQL, и тот, у кого соединение, отправляет предложение в браузер." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="220" y="980" width="1320" height="270" as="geometry" />
        </mxCell>

