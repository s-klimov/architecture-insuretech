        <mxCell id="10" value="Браузер пользователя&lt;br&gt;все регионы и часовые пояса РФ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="78" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Yandex Cloud CDN&lt;br&gt;статика веб-приложения с точек присутствия в регионах РФ&lt;br&gt;время загрузки страницы не зависит от региона" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="164" width="680" height="76" as="geometry" />
        </mxCell>
        <mxCell id="11" value="B2B-партнёры&lt;br&gt;API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="164" width="340" height="76" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Application Load Balancer&lt;br&gt;один адрес для клиента и партнёра, трафик по зонам a, b и d&lt;br&gt;health check: HTTP GET /health, интервал 3 с, порог 2&lt;br&gt;фейловер active-active: зона без ответа выводится из балансировки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="292" width="1060" height="92" as="geometry" />
        </mxCell>

        <mxCell id="31" value="Группа узлов Kubernetes&lt;br&gt;namespace InsureTech&lt;br&gt;реплики: core-app, client-info,&lt;br&gt;ins-product-aggregator,&lt;br&gt;ins-comp-settlement&lt;br&gt;автомасштабирование узлов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1">
