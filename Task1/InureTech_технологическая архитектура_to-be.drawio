          <mxGeometry x="60" y="760" width="1060" height="176" as="geometry" />
        </mxCell>
        <mxCell id="41" value="PostgreSQL · зона a&lt;br&gt;синхронная реплика&lt;br&gt;health check хоста&lt;br&gt;цель автофейловера" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="774" width="220" height="96" as="geometry" />
        </mxCell>
        <mxCell id="42" value="PostgreSQL · зона b&lt;br&gt;master&lt;br&gt;health check хоста" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=3;fontSize=13;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="774" width="220" height="96" as="geometry" />
        </mxCell>
        <mxCell id="43" value="PostgreSQL · зона d&lt;br&gt;асинхронная реплика&lt;br&gt;health check хоста" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="774" width="220" height="96" as="geometry" />
        </mxCell>
        <mxCell id="45" value="Managed Service for PostgreSQL · один кластер, без шардирования (данных 50 GB)&lt;br&gt;сервисы всех зон подключаются к endpoint мастера · автофейловер на синхронную реплику" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="876" width="1020" height="48" as="geometry" />
        </mxCell>

        <mxCell id="50" value="Object Storage&lt;br&gt;бэкапы и WAL, PITR · RPO ≤ 15 мин" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;fontFamily=Helvetica;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="972" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="51" value="Регион ru-central1 · Managed Service for Kubernetes, один растянутый кластер, мастера в зонах a, b и d" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="1052" width="1060" height="36" as="geometry" />
        </mxCell>

        <mxCell id="61" value="&lt;b&gt;Масштабирование&lt;/b&gt;&lt;br&gt;Горизонтальное: реплики подов и группы узлов в трёх зонах, число узлов растёт вместе с нагрузкой. Вертикальное масштабирование не закрывает отказ зоны и ограничено размером виртуальной машины." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1170" y="78" width="490" height="130" as="geometry" />
        </mxCell>
        <mxCell id="62" value="&lt;b&gt;Kubernetes&lt;/b&gt;&lt;br&gt;Один растянутый региональный кластер. Мастер в трёх зонах переживает отказ площадки, поды поднимаются на живых узлах за минуты: это укладывается в RTO 45 мин и доступность 99,9%. Узлы обновляются по одной зоне, поэтому сервис работает 24/7 для всех часовых поясов. Отдельный кластер на каждую зону усложнил бы выкладку и для этих требований не нужен." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1170" y="222" width="490" height="200" as="geometry" />
        </mxCell>
        <mxCell id="63" value="&lt;b&gt;Балансировка и фейловер&lt;/b&gt;&lt;br&gt;Клиент и партнёр обращаются к одному адресу Application Load Balancer. На каждую зону есть health check HTTP GET /health (интервал 3 с, порог 2). Зона без ответа снимается с нагрузки. Режим active-active, переключение автоматическое, адрес для клиента не меняется." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1170" y="436" width="490" height="170" as="geometry" />
        </mxCell>
        <mxCell id="64" value="&lt;b&gt;База данных&lt;/b&gt;&lt;br&gt;Три хоста Managed PostgreSQL в разных зонах: master, синхронная реплика и асинхронная реплика. При отказе мастера кластер переключается на синхронную реплику, зафиксированные данные не теряются. Копии и WAL лежат в Object Storage, точка восстановления не старше 15 мин. Шардирование не используется: объём данных 50 GB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1170" y="620" width="490" height="200" as="geometry" />
        </mxCell>
        <mxCell id="65" value="&lt;b&gt;Потеря всего региона&lt;/b&gt;&lt;br&gt;Кластер PostgreSQL восстанавливается из Object Storage в другом регионе. RTO до 45 мин, RPO до 15 мин." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1170" y="834" width="490" height="100" as="geometry" />
        </mxCell>

